TELEGRAM_BOT_TOKEN=
OPENROUTER_API_KEY=
FLUE_URL=http://localhost:3583
# Public URL of the deployed dashboard, used for /login magic links
DASHBOARD_URL=http://localhost:3100
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=
UPSTASH_BOX_API_KEY=
# Hosted pages the agent writes for a user (travel plan, meal plan…). Token of a
# PUBLIC Upstash Blob bucket — private buckets have no shareable URL. Optional:
# without it publish_page tells the model the feature is off.
UPSTASH_BLOB_TOKEN=
# MapToAgent (maproom) key for publish_map. Self-serve:
#   curl -s -X POST https://maptoagent.xyz/v1/register -H 'Content-Type: application/json' -d '{"name":"my-agent"}'
# Optional: without it publish_map tells the model the feature is off.
MAPROOM_API_KEY=
VISION_MODEL=google/gemma-4-26b-a4b-it:free
NEBIUS_API_KEY=
# Hidden-reasoning budget for tool-calling turns (low|medium|high|off). "low" cuts
# minutes off map/page turns with no measured quality loss. Vision calls are exempt.
NEBIUS_REASONING_EFFORT=low
# Webhook mode (Cloud Run scale-to-zero)
SERVICE_URL=
TELEGRAM_WEBHOOK_SECRET=
INTERNAL_API_SECRET=
QSTASH_TOKEN=
# Voice (Fish Audio: ASR for inbound voice notes, TTS for voice replies)
FISH_AUDIO_TOKEN=
# optional: pin a voice (fish.audio model gallery reference id) / TTS model
FISH_VOICE_ID=
FISH_TTS_MODEL=s2.1-pro-free
# STT via OpenRouter /v1/audio/transcriptions (fallback: Fish ASR).
# Alternatives: openai/whisper-large-v3 (Turkish-proven)
STT_MODEL=x-ai/grok-stt-1.0
# iMessage via Photon Spectrum (optional). Project ID + secret from the Photon
# dashboard (project Settings). The webhook secret is written here by
# `./deploy-cloudrun.sh imessage-webhook` — Photon shows it only once.
# Free/Pro plans only reach users added under Users in the Photon dashboard.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
SPECTRUM_WEBHOOK_SECRET=
# Google Places API (New) key for place_details (ratings, hours, Google reviews).
# Optional: list import and Sezar place lists work without it. Restrict the key
# to the Places API (New). IDs-only search is free; details with reviews are
# 1,000 free/month, then ~$25 per 1,000.
GOOGLE_MAPS_API_KEY=
# Exa for web_search: live place search (Exa Places) and the open web.
# Optional: without it Sezar recommends from memory and says so. ~$0.008/search;
# $10 free credits a month.
EXA_API_KEY=
